{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/servicios", "destination": "/servicios/index.html" },
    { "source": "/nosotros", "destination": "/nosotros/index.html" },
    { "source": "/recursos", "destination": "/recursos/index.html" },
    { "source": "/academia", "destination": "/academia/index.html" },
    { "source": "/herramientas", "destination": "/herramientas/index.html" },
    { "source": "/casos", "destination": "/casos/index.html" },
    { "source": "/portal", "destination": "/portal/index.html" },
    { "source": "/contacto", "destination": "/contacto/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
